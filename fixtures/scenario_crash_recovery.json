{
  "schema": "crashfence.scenario.v1",
  "name": "partial frame, restart, retry, quorum commit",
  "steps": [
    {
      "op": "grant_owner_token",
      "token_id": "t1",
      "token": {
        "epoch": 1,
        "coordinator": "obs-b",
        "lease_id": "l-crash",
        "not_before": 0,
        "expires_at": 100
      }
    },
    {
      "op": "request_authorization",
      "proposal_id": "a1",
      "auth_id": "auth-crash"
    },
    {
      "op": "write_frame",
      "proposal": "a1",
      "node": "n1",
      "token": "t1",
      "partial_bytes": 20
    },
    {
      "op": "crash",
      "node": "n1"
    },
    {
      "op": "restart",
      "node": "n1"
    },
    {
      "op": "assert",
      "node": "n1",
      "recovery_classification": "last_frame_incomplete"
    },
    {
      "op": "write_frame",
      "proposal": "a1",
      "node": "n1",
      "token": "t1"
    },
    {
      "op": "write_frame",
      "proposal": "a1",
      "node": "n2",
      "token": "t1"
    },
    {
      "op": "publish_commit_marker",
      "proposal": "a1",
      "token": "t1"
    },
    {
      "op": "restart",
      "node": "n1"
    },
    {
      "op": "assert",
      "node": "n1",
      "recovery_classification": "clean"
    },
    {
      "op": "assert",
      "committed_version": 1
    }
  ]
}
